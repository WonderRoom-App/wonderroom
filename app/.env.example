# Postgres connection string. This one matches `npm run db:up`.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
# Signs logins. Use a long random value.
PAYLOAD_SECRET=change-me
# Optional. Relative paths count from the app folder.
# WONDERROOM_CONFIG_DIR=../config
# WONDERROOM_DATA_DIR=../data
# WONDERROOM_STEP_TIMEOUT_MS=300000
# WONDERROOM_LOCK_TIMEOUT_MS=300000
