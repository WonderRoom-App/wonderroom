{
  "name": "wonderroom",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "dev": "npm run dev -w app",
    "db:up": "docker compose -f compose.dev.yml up -d --wait",
    "start": "npm run start:engine -w app"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  }
}
